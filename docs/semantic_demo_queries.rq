# Query 1: Genres as resources
PREFIX pred: <http://music.org/pred/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?genre ?genreLabel (COUNT(DISTINCT ?song) AS ?numSongs)
WHERE {
  ?song pred:hasGenre ?genre .
  ?genre rdfs:label ?genreLabel .
}
GROUP BY ?genre ?genreLabel
ORDER BY DESC(?numSongs)
LIMIT 10


# Query 2: Entries by chart
PREFIX type: <http://music.org/type/>
PREFIX pred: <http://music.org/pred/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?chart ?chartLabel (COUNT(?entry) AS ?numEntries)
WHERE {
  ?entry a type:ChartEntry ;
         pred:inChart ?chart .
  ?chart rdfs:label ?chartLabel .
}
GROUP BY ?chart ?chartLabel
ORDER BY DESC(?numEntries)


# Query 3: Songs by album resources
PREFIX pred: <http://music.org/pred/>

SELECT ?album (SAMPLE(?albumName) AS ?albumLabel) (COUNT(DISTINCT ?song) AS ?numSongs)
WHERE {
  ?song pred:album ?album .
  ?album pred:name ?albumName .
}
GROUP BY ?album
ORDER BY DESC(?numSongs)
LIMIT 10


# Inference check: performer should include mainArtist/featuredArtist if ruleset infers subPropertyOf
PREFIX pred: <http://music.org/pred/>

SELECT ?song ?artist
WHERE {
  ?song pred:performer ?artist .
}
LIMIT 20


# Inference check: inverse relation performed
PREFIX pred: <http://music.org/pred/>

SELECT ?artist ?song
WHERE {
  ?artist pred:performed ?song .
}
LIMIT 20


# Materialized inference: long-tail songs (MAX weeks >= threshold)
PREFIX type: <http://music.org/type/>

SELECT (COUNT(DISTINCT ?song) AS ?longTailSongs)
WHERE {
  ?song a type:LongTailSong .
}


# Materialized inference: longest charting long-tail songs
PREFIX type: <http://music.org/type/>
PREFIX pred: <http://music.org/pred/>

SELECT ?song ?songName (MAX(?weeks) AS ?maxWeeks)
WHERE {
  ?song a type:LongTailSong ;
        pred:name ?songName .
  ?entry pred:song ?song ;
         pred:weeks ?weeks .
}
GROUP BY ?song ?songName
ORDER BY DESC(?maxWeeks)
LIMIT 20


# Materialized inference: long-tail songs by artist
PREFIX type: <http://music.org/type/>
PREFIX pred: <http://music.org/pred/>

SELECT ?artist ?artistName (COUNT(DISTINCT ?song) AS ?longTailSongs)
WHERE {
  ?song a type:LongTailSong ;
        pred:mainArtist ?artist .
  ?artist pred:name ?artistName .
}
GROUP BY ?artist ?artistName
ORDER BY DESC(?longTailSongs)
LIMIT 15


# Popularity comparison: long-tail songs vs others
PREFIX type: <http://music.org/type/>
PREFIX pred: <http://music.org/pred/>

SELECT ?category (AVG(?popularity) AS ?avgPopularity)
WHERE {
  ?song pred:popularity ?popularity .
  BIND(
    IF(EXISTS { ?song a type:LongTailSong }, "Long-tail songs", "Other songs")
    AS ?category
  )
}
GROUP BY ?category


# Materialized inference: charted songs
PREFIX type: <http://music.org/type/>

SELECT (COUNT(DISTINCT ?song) AS ?chartedSongs)
WHERE {
  ?song a type:ChartedSong .
}


# Materialized inference: hit songs (Top 10)
PREFIX type: <http://music.org/type/>
PREFIX pred: <http://music.org/pred/>

SELECT ?song ?songName
WHERE {
  ?song a type:HitSong ;
        pred:name ?songName .
}
ORDER BY ?songName
LIMIT 20


# Materialized inference: hit artists
PREFIX type: <http://music.org/type/>
PREFIX pred: <http://music.org/pred/>

SELECT ?artist ?artistName
WHERE {
  ?artist a type:HitArtist ;
          pred:name ?artistName .
}
ORDER BY ?artistName
LIMIT 20


# Materialized inference: artist appears in chart
PREFIX pred: <http://music.org/pred/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?artist ?artistName ?chartLabel
WHERE {
  ?artist pred:name ?artistName ;
          pred:appearsInChart ?chart .
  ?chart rdfs:label ?chartLabel .
}
ORDER BY ?artistName
LIMIT 20
